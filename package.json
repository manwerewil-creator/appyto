{
  "name": "appyto",
  "version": "0.1.0",
  "private": true,
  "description": "Appyto — a portable, local-first web app that aggregates Zimbabwean jobs (jobszimbabwe.co.zw, applynow.co.zw), matches them to you with pure code, and applies on your behalf via your own Gmail/SMTP.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scrape": "tsx scripts/scrape/run.ts",
    "scrape:jobszimbabwe": "tsx scripts/scrape/run.ts --source=jobszimbabwe",
    "scrape:applynow": "tsx scripts/scrape/run.ts --source=applynow",
    "scrape:sample": "tsx scripts/scrape/run.ts --pages=2",
    "emails:samples": "tsx scripts/email-samples.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^15.0.3",
    "nodemailer": "^6.9.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.0",
    "csv-stringify": "^6.5.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
